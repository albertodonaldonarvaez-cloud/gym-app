generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  COACH
  CLIENT
  ADMIN
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  passwordHash  String?  @map("password_hash")
  name          String   @default("")
  role          Role     @default(CLIENT)
  coachId       String?  @map("coach_id")
  avatar        String   @default("")
  goal          String   @default("Acondicionamiento Físico")
  weightKg      Float    @default(70.0) @map("weight_kg")
  heightCm      Int      @default(170) @map("height_cm")
  maxClients    Int      @default(10) @map("max_clients")
  emailVerified Boolean  @default(false) @map("email_verified")
  verifyToken   String?  @map("verify_token")
  verifyExpires DateTime? @map("verify_expires")
  inviteToken   String?  @map("invite_token")
  inviteExpires DateTime? @map("invite_expires")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  coach         User?    @relation("CoachClients", fields: [coachId], references: [id])
  clients       User[]   @relation("CoachClients")
  routinesAsCoach   RoutinePlan[] @relation("CoachPlans")
  routinesAsAthlete RoutinePlan[] @relation("AthletePlans")
  routineTemplates  RoutineTemplate[] @relation("CoachTemplates")
  workoutLogs   WorkoutLog[]
  setLogs       SetLog[]
  warmupSessions WarmupSession[] @relation("AthleteWarmups")

  @@map("users")
}

model Exercise {
  id            String   @id @default(cuid())
  name          String
  muscleGroup   String   @map("muscle_group")
  category      String   @default("General")
  equipment     String   @default("Libre")
  instructions  String   @default("")
  instructionsEs String? @map("instructions_es")
  defaultSets   Int      @default(4) @map("default_sets")
  defaultReps   Int      @default(12) @map("default_reps")
  mediaFilename String?  @map("media_filename")
  mediaUrl      String?  @map("media_url")
  videoUrl      String?  @map("video_url")
  isCustom      Boolean  @default(false) @map("is_custom")
  coachId       String?  @map("coach_id")
  hashMd5       String?  @map("hash_md5")
  createdAt     DateTime @default(now()) @map("created_at")

  setLogs       SetLog[]

  @@map("exercises")
}

model RoutinePlan {
  id         String   @id @default(cuid())
  coachId    String   @map("coach_id")
  athleteId  String   @map("athlete_id")
  title      String   @default("Rutina Semanal")
  description String  @default("Plan personalizado")
  schedule   Json
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  coach      User     @relation("CoachPlans", fields: [coachId], references: [id])
  athlete    User     @relation("AthletePlans", fields: [athleteId], references: [id])

  @@map("routine_plans")
}

model WorkoutLog {
  id              String   @id @default(cuid())
  athleteId       String   @map("athlete_id")
  sessionId       String?  @map("session_id")      // UUID from device for dedup
  dayName         String   @default("") @map("day_name")  // e.g. "Lunes"
  date            DateTime @default(now())
  startedAt       DateTime? @map("started_at")
  finishedAt      DateTime? @map("finished_at")
  durationSeconds Int?     @map("duration_seconds")
  caloriesBurned  Float?   @map("calories_burned")
  avgHr           Int?     @map("avg_hr")
  source          String   @default("manual")
  createdAt       DateTime @default(now()) @map("created_at")

  athlete         User     @relation(fields: [athleteId], references: [id])
  setLogs         SetLog[]

  @@index([athleteId, date])
  @@index([sessionId])
  @@map("workout_logs")
}

model SetLog {
  id           String   @id @default(uuid())
  clientLogId  String   @unique @map("client_log_id")
  workoutLogId String   @map("workout_log_id")
  athleteId    String   @map("athlete_id")
  exerciseId   String   @map("exercise_id")
  sessionId    String?  @map("session_id")
  dayName      String   @default("") @map("day_name")
  exerciseName String   @default("") @map("exercise_name")
  weightKg     Float    @default(0) @map("weight_kg")
  reps         Int      @default(0)
  rpe          Float?   @default(0)
  setNumber    Int      @default(1) @map("set_number")
  restSeconds  Int?     @map("rest_seconds")        // actual rest taken after this set
  startedAt    DateTime? @map("started_at")
  completedAt  DateTime? @map("completed_at")
  notes        String   @default("")
  createdAt    DateTime @default(now()) @map("created_at")

  workoutLog   WorkoutLog @relation(fields: [workoutLogId], references: [id])
  athlete      User       @relation(fields: [athleteId], references: [id])
  exercise     Exercise   @relation(fields: [exerciseId], references: [id])

  @@index([athleteId, exerciseId])
  @@index([sessionId])
  @@map("set_logs")
}

model RoutineTemplate {
  id          String   @id @default(cuid())
  coachId     String   @map("coach_id")
  title       String
  description String   @default("Plantilla de rutina")
  schedule    Json
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  coach       User     @relation("CoachTemplates", fields: [coachId], references: [id])

  @@map("routine_templates")
}

model WarmupSession {
  id          String   @id @default(cuid())
  athleteId   String   @map("athlete_id")
  startedAt   DateTime @map("started_at")
  finishedAt  DateTime? @map("finished_at")
  durationSec Int      @default(0) @map("duration_sec")
  notes       String   @default("")
  isSynced    Boolean  @default(false) @map("is_synced")
  createdAt   DateTime @default(now()) @map("created_at")

  athlete     User     @relation("AthleteWarmups", fields: [athleteId], references: [id])

  @@index([athleteId, startedAt])
  @@map("warmup_sessions")
}

model SystemSetting {
  key       String   @id
  value     String
  category  String   @default("general")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("system_settings")
}